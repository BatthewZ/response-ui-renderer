    },
    "activity": {
      "type": "static",
      "value": [
        {
          "id": "act-1",
          "icon": "package-check",
          "actor": "warehouse-eu",
          "action": "picked",
          "target": "ORD-4419",
          "timestamp": "18 minutes ago",
          "note": "Split across two consignments; the second leaves on tomorrow's van."
        },
        {
          "id": "act-2",
          "icon": "shield-alert",
          "actor": "fraud-screen",
          "action": "flagged",
          "target": "ORD-4420",
          "timestamp": "52 minutes ago",
          "note": "Billing country and shipping country disagree."
        },
        {
          "id": "act-3",
          "icon": "credit-card",
          "actor": "payments-bot",
          "action": "retried the capture on",
          "target": "ORD-4418",
          "timestamp": "2 hours ago"
        },
        {
          "id": "act-4",
