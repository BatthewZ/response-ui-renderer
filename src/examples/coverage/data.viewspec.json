    "flags": {
      "type": "static",
      "value": { "heldForReview": 1 }
    }
  },
  "root": {
    "component": "Container",
    "props": { "size": "full" },
    "children": [
      {
        "component": "Stack",
        "props": { "gap": "r6" },
        "children": [
          {
            "component": "Row",
            "props": { "justify": "between", "align": "start" },
            "children": [
              {
                "component": "Stack",
                "props": { "gap": "r1" },
                "children": [
                  { "component": "Text", "props": { "variant": "h2" }, "children": ["Order operations"] },
                  {
                    "component": "Text",
                    "props": { "variant": "body-2", "color": "muted" },
                    "children": ["Everything that happened to the order book in the last 24 hours."]
                  }
                ]
              },
              {
                "component": "Row",
                "props": { "gap": "r2" },
                "children": [
                  { "component": "Badge", "props": { "variant": "info" }, "children": ["Live"] },
                  {
                    "$cond": "data.flags.heldForReview",
                    "then": {
                      "component": "Badge",
                      "props": { "variant": "error" },
                      "children": ["1 order held for review"]
                    },
                    "else": {
                      "component": "Badge",
                      "props": { "variant": "success" },
                      "children": ["Review queue clear"]
                    }
                  }
                ]
              }
            ]
          },

          { "component": "Divider" },

          {
            "component": "Card",
            "props": { "padding": "r4" },
            "children": [
              {
                "component": "Stack",
                "props": { "gap": "r4" },
                "children": [
                  {
                    "component": "Row",
                    "children": [
                      { "component": "Text", "props": { "variant": "h4" }, "children": ["Recent orders"] },
                      { "component": "Spacer" },
                      {
                        "component": "Text",
                        "props": { "variant": "body-3", "color": "muted" },
                        "children": ["Five to a page, newest first"]
                      }
                    ]
                  },
                  {
                    "component": "DataTable",
                    "props": {
                      "data": { "$ref": "data.orders" },
                      "rowKey": "id",
                      "pageSize": 5,
                      "density": "comfortable",
                      "striped": true,
                      "stickyHeader": true,
                      "maxHeight": 360,
                      "defaultSort": { "key": "placed", "direction": "desc" },
                      "columns": [
                        { "key": "id", "header": "Order", "width": 120, "sortable": true },
                        { "key": "customer", "header": "Customer", "sortable": true },
                        { "key": "region", "header": "Region", "width": 110 },
                        { "key": "items", "header": "Items", "align": "right", "width": 90, "sortable": true },
                        { "key": "total", "header": "Total", "align": "right", "width": 120 },
                        { "key": "placed", "header": "Placed", "width": 120, "sortable": true },
                        {
                          "key": "status",
                          "header": "Status",
                          "width": 190,
                          "render": {
                            "$node": {
                              "component": "Badge",
                              "props": { "variant": { "$ref": "row.tone" } },
                              "children": [{ "$ref": "row.status" }]
                            }
                          }
                        }
                      ],
                      "footer": {
                        "$node": {
                          "component": "Text",
                          "props": { "variant": "body-3", "color": "muted" },
                          "children": ["Eight orders in this window. Anything older is in the archive."]
                        }
                      },
                      "emptyContent": {
                        "$node": {
                          "component": "Center",
                          "children": [
                            {
                              "component": "Text",
                              "props": { "variant": "body-2", "color": "muted" },
                              "children": ["No orders were placed in this window."]
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },

          {
            "component": "Card",
            "props": { "padding": "r4" },
            "children": [
              {
                "component": "Stack",
                "props": { "gap": "r4" },
                "children": [
                  { "component": "Text", "props": { "variant": "h4" }, "children": ["Audit log"] },
                  {
                    "component": "Text",
                    "props": { "variant": "body-3", "color": "muted" },
                    "children": [
                      "Built from Table's own parts rather than from DataTable, because the server owns both the sort and the paging here."
                    ]
                  },
                  {
                    "component": "Table",
                    "props": {
                      "density": "comfortable",
                      "striped": true,
                      "stickyHeader": true,
                      "maxHeight": 320,
                      "tableProps": { "aria-label": "Audit log, page 3 of 9" }
                    },
                    "children": [
                      {
                        "component": "Table.Head",
                        "children": [
                          {
                            "component": "Table.Row",
                            "children": [
                              {
                                "component": "Table.HeaderCell",
                                "props": {
                                  "scope": "col",
                                  "sortDirection": "desc",
                                  "onSort": {
                                    "action": "setState",
                                    "payload": { "key": "auditSort", "value": "when" }
                                  }
                                },
                                "children": ["Time"]
                              },
                              {
                                "component": "Table.HeaderCell",
                                "props": {
                                  "scope": "col",
                                  "onSort": {
                                    "action": "setState",
                                    "payload": { "key": "auditSort", "value": "actor" }
                                  }
                                },
                                "children": ["Actor"]
                              },
                              { "component": "Table.HeaderCell", "props": { "scope": "col" }, "children": ["Event"] },
                              { "component": "Table.HeaderCell", "props": { "scope": "col" }, "children": ["Order"] },
                              { "component": "Table.HeaderCell", "props": { "scope": "col" }, "children": ["Outcome"] }
                            ]
                          }
                        ]
                      },
                      {
                        "component": "Table.Body",
                        "children": [
                          {
                            "$each": "data.auditEntries",
                            "as": "entry",
                            "node": {
                              "component": "Table.Row",
                              "props": { "index": { "$ref": "entryIndex" } },
                              "children": [
                                { "component": "Table.Cell", "children": [{ "$ref": "entry.when" }] },
                                { "component": "Table.Cell", "children": [{ "$ref": "entry.actor" }] },
                                { "component": "Table.Cell", "children": [{ "$ref": "entry.event" }] },
                                { "component": "Table.Cell", "children": [{ "$ref": "entry.target" }] },
                                {
                                  "component": "Table.Cell",
                                  "children": [
                                    {
                                      "component": "Badge",
                                      "props": { "variant": { "$ref": "entry.tone" } },
                                      "children": [{ "$ref": "entry.outcome" }]
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "component": "Center",
                    "children": [
                      {
                        "component": "Pagination",
                        "props": {
                          "page": { "$ref": "state.page" },
                          "totalPages": 9,
                          "siblingCount": 1,
                          "showEdges": true,
                          "compactBelow": "40rem",
                          "aria-label": "Audit log pages",
                          "onPageChange": {
                            "action": "setState",
                            "payload": { "key": "page", "value": { "$ref": "event.value" } }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },

          {
            "component": "Grid",
            "props": { "columns": { "base": 1, "md": 2 }, "gap": "r5" },
            "children": [
              {
                "component": "Card",
                "props": { "padding": "r4" },
                "children": [
                  {
                    "component": "Stack",
                    "props": { "gap": "r4" },
                    "children": [
                      { "component": "Text", "props": { "variant": "h4" }, "children": ["Activity"] },
                      {
                        "component": "ActivityFeed",
                        "children": [
                          {
                            "$each": "data.activity",
                            "as": "item",
                            "node": {
                              "component": "ActivityFeed.Item",
                              "props": {
                                "icon": { "$ref": "item.icon" },
                                "actor": { "$ref": "item.actor" },
                                "action": { "$ref": "item.action" },
                                "target": { "$ref": "item.target" },
                                "timestamp": { "$ref": "item.timestamp" }
                              },
                              "children": [
                                {
                                  "$cond": "item.note",
                                  "then": {
                                    "component": "Text",
                                    "props": { "variant": "body-3", "color": "secondary" },
                                    "children": [{ "$ref": "item.note" }]
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "component": "Card",
                "props": { "padding": "r4" },
                "children": [
                  {
                    "component": "Stack",
                    "props": { "gap": "r4" },
                    "children": [
                      { "component": "Text", "props": { "variant": "h4" }, "children": ["ORD-4422, end to end"] },
                      {
                        "component": "Timeline",
                        "props": { "animate": false },
                        "children": [
                          {
                            "$each": "data.milestones",
                            "as": "milestone",
                            "node": {
                              "component": "Timeline.Item",
                              "props": {
                                "date": { "$ref": "milestone.date" },
                                "title": { "$ref": "milestone.title" },
                                "titleAs": "h5",
                                "icon": { "$ref": "milestone.icon" }
                              },
                              "children": [
                                {
                                  "component": "Text",
                                  "props": { "variant": "body-3", "color": "secondary" },
                                  "children": [{ "$ref": "milestone.detail" }]
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },

          {
            "component": "Card",
            "props": { "padding": "r4" },
            "children": [
              {
                "component": "Stack",
                "props": { "gap": "r4" },
                "children": [
                  {
                    "component": "Row",
                    "children": [
                      { "component": "Text", "props": { "variant": "h4" }, "children": ["Ledger"] },
                      { "component": "Spacer" },
                      {
                        "component": "Text",
                        "props": { "variant": "body-3", "color": "muted" },
                        "children": ["Windowed, so the whole journal scrolls without mounting every row."]
                      }
                    ]
                  },
                  {
                    "component": "VirtualizedDataTable",
                    "props": {
                      "data": { "$ref": "data.ledger" },
                      "rowKey": "id",
                      "rowHeight": 44,
                      "height": 320,
                      "overscan": 6,
                      "density": "dense",
                      "striped": true,
                      "stickyHeader": true,
                      "columns": [
                        { "key": "id", "header": "Entry", "width": 140 },
                        { "key": "posted", "header": "Posted", "width": 160, "sortable": true },
                        { "key": "account", "header": "Account", "sortable": true },
                        { "key": "reference", "header": "Order", "width": 120 },
                        { "key": "amount", "header": "Amount", "align": "right", "width": 120 },
                        {
                          "key": "direction",
                          "header": "Direction",
                          "align": "right",
                          "width": 110,
                          "render": {
                            "$node": {
                              "component": "Badge",
                              "props": { "variant": "default" },
                              "children": [{ "$ref": "row.direction" }]
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
