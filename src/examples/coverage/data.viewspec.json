    "milestones": {
      "type": "static",
      "value": [
        {
          "id": "ms-1",
          "date": "22 July",
          "title": "Order placed",
          "detail": "Twelve items reserved from the US-East warehouse.",
          "icon": "file-clock"
        },
        {
          "id": "ms-2",
          "date": "22 July",
          "title": "Payment captured",
          "detail": "£2,940.00 settled by card, net of an £8.51 gateway fee.",
          "icon": "credit-card"
        },
        {
          "id": "ms-3",
          "date": "23 July",
          "title": "Handed to the carrier",
          "detail": "Two parcels, tracked as 1Z-9K4 and 1Z-9K5.",
          "icon": "truck"
        },
        {
          "id": "ms-4",
