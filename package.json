{
  "name": "@batthewz/response-ui-renderer",
  "version": "0.1.0",
  "type": "module",
  "description": "Render declarative JSON (ViewSpec) as @batthewz/response-ui-react-components. The machine-authorable layer of the response-ui design system.",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "import": "./dist/spec/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    },
    "./styles": "./dist/styles.css",
    "./examples": {
      "types": "./dist/examples/index.d.ts",
      "import": "./dist/examples/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit && eslint src",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run build && bun run typecheck && bun run test",
    "dev": "vite --config dev/vite.config.ts",
    "dev:build": "vite build --config dev/vite.config.ts"
  },
  "peerDependencies": {
    "@batthewz/response-ui-react-components": "^0.9.0",
    "@floating-ui/react": "^0.27.0",
    "lucide-react": "^0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@batthewz/response-ui-css": "^0.9.0",
    "@batthewz/response-ui-react-components": "^0.9.0",
    "@eslint/js": "^10.0.1",
    "@floating-ui/react": "^0.27.19",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "glob": "^13.0.6",
    "jsdom": "^29.0.1",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.55.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2",
    "zod": "^4.4.3"
  },
  "keywords": [
    "design-system",
    "react",
    "json",
    "renderer",
    "server-driven-ui",
    "response-ui",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BatthewZ/response-ui-renderer.git"
  },
  "homepage": "https://github.com/BatthewZ/response-ui-renderer#readme",
  "bugs": "https://github.com/BatthewZ/response-ui-renderer/issues",
  "author": "BatthewZ"
}
